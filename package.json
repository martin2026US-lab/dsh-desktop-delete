{
  "name": "dsh-desktop-delete",
  "version": "0.1.1",
  "description": "Delete conversations from the DeepSeek Harness desktop session menu",
  "type": "module",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CHANGELOG.md", "VALIDATION.md", "docs/images", "LICENSE"],
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-renderer"] } },
  "engines": { "node": ">=24", "dsh": "0.2.0-rc.2" },
  "scripts": { "test": "node --test test/*.test.js", "test:integration": "node --test test/integration/*.test.mjs", "check": "node --check lib/index.js && node --check lib/client.js", "verify": "node --check lib/index.js && node --check lib/client.js && node --test test/*.test.js", "prepack": "node --check lib/index.js && node --check lib/client.js && node --test test/*.test.js" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "desktop", "conversation", "delete"],
  "author": "martin2026US-lab",
  "repository": { "type": "git", "url": "git+https://github.com/martin2026US-lab/dsh-desktop-delete.git" },
  "homepage": "https://github.com/martin2026US-lab/dsh-desktop-delete#readme",
  "bugs": { "url": "https://github.com/martin2026US-lab/dsh-desktop-delete/issues" },
  "license": "MIT"
}
